{
  "name": "rbackup",
  "description": "Backup Manager for Restic",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --test tests/*.test.ts",
    "test:desktop": "node --test tests/desktop-smoke.mjs",
    "test:restore": "node tests/treeSelection.test.ts && cargo test --manifest-path src-tauri/Cargo.toml real_restic_restore_selected_paths_from_snapshot --lib -- --ignored --test-threads=1",
    "build:deb": "tauri build --bundles deb",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "@tauri-apps/cli": "^2"
  }
}
